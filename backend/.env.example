# ==============================================================================
# ChessCure PMS Backend - Environment Configuration Example
# Copy this file to '.env' and customize values for your local environment.
# NEVER commit real passwords, secret keys, or credentials to Git.
# ==============================================================================

# Database Configuration (Defaults to local SQLite for instant zero-config setup)
# For local SQLite:
DATABASE_URL=sqlite:///./chess_cure.db
# For PostgreSQL (e.g. Neon / Supabase / Local):
# DATABASE_URL=postgresql://username:password@localhost:5432/chesscure_db?sslmode=prefer

# JWT Secret & Token Expiration
SECRET_KEY=change-this-to-a-secure-random-jwt-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Optional Default Seed Administrator User
SEED_ADMIN_USERNAME=admin_player
SEED_ADMIN_EMAIL=player@example.com
SEED_ADMIN_MOBILE=+1 555-0199
SEED_ADMIN_PASSWORD=ChangeThisPassword123!
SEED_BENSPIDY_ID=benspidy_oauth

# Email Delivery (SMTP) Configuration for OTP Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@chesscure.com
SMTP_FROM_NAME=ChessCure Security
SMTP_TLS=true
SMTP_SSL=false

# SMS Mobile Delivery (Twilio) Configuration (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

